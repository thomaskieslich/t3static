{
	"name": "thomask/t3static",
	"description": "Collection of Tools to Test, Lint and Upgrade multiple TYPO3 Extensions.",
	"license": "GNU GENERAL PUBLIC LICENSE",
	"type": "library",
	"require-dev": {
		"a9f/typo3-fractor": "^0.5.10",
		"ergebnis/composer-normalize": "^2.52",
		"friendsofphp/php-cs-fixer": "^3.95",
		"helmich/typo3-typoscript-lint": "^3.3",
		"michielroos/typo3scan": "dev-master",
		"phpstan/phpstan": "^2.2",
		"seld/jsonlint": "^1.11",
		"ssch/typo3-rector": "^3.14",
		"symfony/yaml": "^7.4",
		"typo3/coding-standards": "^0.8"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"a9f/fractor-extension-installer": true,
			"ergebnis/composer-normalize": true
		},
		"sort-packages": true
	}
}
